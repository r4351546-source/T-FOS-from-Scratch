src/whoami.s: src/whoami.cpp.s
.PHONY : src/whoami.s

# target to generate assembly for a file
src/whoami.cpp.s:
	$(MAKE) $(MAKESILENT) -f CMakeFiles/t-fos.dir/build.make CMakeFiles/t-fos.dir/src/whoami.cpp.s
.PHONY : src/whoami.cpp.s

